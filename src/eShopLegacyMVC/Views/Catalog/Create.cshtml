@model eShopLegacyMVC.Models.CatalogItem

@{
    ViewBag.Title = "Create";
}

<h2 class="esh-body-title">Create</h2>


<form method="post">
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Name" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="CatalogBrandId" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <select name="CatalogBrandId" asp-items="ViewBag.CatalogBrandId" class="form-control"></select>
                <span asp-validation-for="CatalogBrandId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="CatalogTypeId" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <select name="CatalogTypeId" asp-items="ViewBag.CatalogTypeId" class="form-control"></select>
                <span asp-validation-for="CatalogTypeId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Price" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="PictureFileName" class="control-label col-md-2"></label>
            <div class="col-md-4 esh-form-information">
                Uploading images not allowed for this version.
                @*@Html.TextBoxFor(model => model.PictureFileName, new { htmlAttributes = new { @class = "form-control" } })*@
                @*<span asp-validation-for="PictureFileName" class="text-danger"></span>*@
            </div>
        </div>

        <div class="form-group">
            <label asp-for="AvailableStock" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <input asp-for="AvailableStock" class="form-control" />
                <span asp-validation-for="AvailableStock" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="RestockThreshold" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <input asp-for="RestockThreshold" class="form-control" />
                <span asp-validation-for="RestockThreshold" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="MaxStockThreshold" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <input asp-for="MaxStockThreshold" class="form-control" />
                <span asp-validation-for="MaxStockThreshold" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-3 text-right esh-button-actions">
                @Html.ActionLink("[ Cancel ]", "Index", null, new { @class = "btn esh-button esh-button-secondary" })
                <input type="submit" value="[ Create ]" class="btn esh-button esh-button-primary" />
            </div>
        </div>
    </div>
</form>

<div>
    
</div>

@section Scripts {
    <script src="/dist/js/jqueryval.js" asp-append-version="true"></script>
}
