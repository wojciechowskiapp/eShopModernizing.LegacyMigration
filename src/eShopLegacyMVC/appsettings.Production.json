{
  "ConnectionStrings": {
    "CatalogDBContext": "${CONNECTION_STRING_CATALOGDBCONTEXT}"
  },
  "webpages": {
    "Version": "3.0.0.0",
    "Enabled": false
  },
  "ClientValidationEnabled": true,
  "UnobtrusiveJavaScriptEnabled": true,
  "UseMockData": false,
  "UseCustomizationData": false,
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*:443"
      }
    }
  },
  "ApplicationInsights": {
    "InstrumentationKey": "${APPLICATIONINSIGHTS_INSTRUMENTATIONKEY}"
  },
  "AllowedHosts": "*"
}